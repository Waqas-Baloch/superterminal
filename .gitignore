node_modules/
dist/
*.log

# macOS finder junk
.DS_Store

# Super Terminal's own state. Shared standards (rules, context, skills,
# team.json, config.json) ARE committed; local run state is not — see
# .super-t/.gitignore, which the CLI writes for every project.
.super-t/backup/
.super-t/reports/
.super-t/flow/
.super-t/wt/
.super-t/index.json
.super-t/intent.json
.super-t/session.json

# Directories from earlier names of this project. Nothing reads them.
.glint/
.squash/

# Private security notes — a list of known-weak spots must not be public.
docs/*.local.md

# Private: strategy, specs, threat model, security review methodology.
# Kept local so a competitor gets no roadmap and an attacker gets no map.
private/

# Local development tooling. The security-review skill and agent stay on this
# machine: they work where the tools expect them, but publishing a review
# methodology (and what it looks for) helps an attacker more than a user.
.claude/
.super-t/skills/
.super-t/config.json
